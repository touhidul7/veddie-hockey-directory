# Server only. Never prefix database credentials with VITE_.
SUPABASE_TRANSACTIONAL_POOLER_URL=
# Optional alternatives; transaction pooler takes precedence.
SUPABASE_SESSION_POOLER_URL=
SUPABASE_DATABASE_URL=
ADMIN_USER=admin
ADMIN_TOKEN=
# Optional dedicated HMAC key for throttle identifiers; defaults to ADMIN_TOKEN.
RATE_LIMIT_SECRET=
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Public origin used to construct email verification links.
APP_URL=http://localhost:5173

# SMTP delivery stays disabled until credentials and sender are verified.
SMTP_ENABLED=false
SMTP_HOST=
# 587 requires STARTTLS; 465 uses TLS immediately.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Bare, approved sender email address.
SMTP_FROM=
# Secret for the scheduler-only /api/jobs/email endpoint.
CRON_SECRET=

# Optional browser counters; visitors must also explicitly opt in.
ANALYTICS_ENABLED=false

# Enable only after public content/policies are approved. Vercel previews stay noindex.
PUBLIC_INDEXING_ENABLED=false

# Encrypt local operational exports; keep key separately from backup files.
BACKUP_ENCRYPTION_KEY=
